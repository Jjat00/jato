---
import Base from "../layouts/Base.astro";
import Grid from "./Grid.astro";
import { getCopy, getProjects } from "../i18n/copy.js";

interface Props {
  locale: "es" | "en";
}

const { locale } = Astro.props;
const t = getCopy(locale);
const projects = getProjects(locale);
const year = new Date().getFullYear();

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    { "@type": "WebSite", "@id": "https://jato.run/#site", name: "jato", url: "https://jato.run", inLanguage: locale },
    {
      "@type": "ItemList",
      name: t.listTitle,
      itemListElement: projects.map((p, i) => ({
        "@type": "ListItem",
        position: i + 1,
        item: { "@type": "SoftwareApplication", name: p.name, description: p.line, url: p.href },
      })),
    },
  ],
};
---

<Base lang={locale} title={t.title} description={t.description}>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} />

  <header class="mx-auto flex max-w-6xl items-center justify-between px-4 py-6 sm:px-8">
    <a href={locale === "es" ? "/" : "/en/"} class="group flex items-baseline gap-0.5" aria-label="jato.run">
      <span class="text-2xl font-semibold tracking-tight">jato</span>
      <span class="font-mono text-sm text-dim transition-colors group-hover:text-muted">.run</span>
    </a>
    <nav class="flex items-center gap-5 font-mono text-xs uppercase tracking-widest text-muted">
      <a href={t.other.href} class="hover:text-fg" hreflang={t.other.label.toLowerCase()}>{t.other.label}</a>
      <a href="https://github.com/Jjat00" class="hover:text-fg" rel="me">GitHub ↗</a>
      <a href="https://github.com/Jjat00/jato" class="hover:text-fg" title={t.starTitle}>{t.star}</a>
    </nav>
  </header>

  <main>
    <section class="relative isolate flex min-h-[78dvh] flex-col items-center justify-center px-4 text-center sm:px-8">
      <Grid labels={t.snake} />
      <div class="hero-ui flex flex-col items-center transition-opacity duration-300">
        <h1 class="rise text-5xl font-semibold leading-[0.95] tracking-tighter sm:text-7xl md:text-8xl" style="animation-delay: 80ms">
          {t.h1[0]} <span class="grad">{t.h1[1]}</span>
        </h1>
        {t.sub && <p class="rise mt-7 max-w-xl text-base text-muted sm:text-lg" style="animation-delay: 160ms">{t.sub}</p>}
        <div class="rise mt-10 flex flex-wrap justify-center gap-3" style="animation-delay: 240ms">
          <a href="#proyectos" class="bg-fg px-5 py-3 text-sm font-medium text-ink transition hover:bg-white">
            {t.ctaPrimary} ↓
          </a>
          <a
            href="https://github.com/Jjat00"
            class="border border-line bg-panel/60 px-5 py-3 text-sm font-medium text-fg backdrop-blur transition hover:border-dim"
          >
            {t.ctaSecondary} ↗
          </a>
        </div>
      </div>
      <button
        id="snake-play"
        type="button"
        class="hero-ui rise absolute bottom-8 left-1/2 flex -translate-x-1/2 items-center gap-2 border border-line bg-panel/70 px-3 py-1.5 font-mono text-[11px] uppercase tracking-widest text-muted backdrop-blur transition hover:border-cyan hover:text-cyan"
        style="animation-delay: 400ms"
      >
        <span class="text-cyan">▶</span> {t.snake.play}
      </button>
    </section>

    <section id="proyectos" class="mx-auto max-w-6xl scroll-mt-8 px-4 pb-24 sm:px-8">
      <div class="mb-5 flex flex-wrap items-end justify-between gap-2">
        <h2 class="text-xl font-semibold tracking-tight">{t.listTitle}</h2>
        {t.listHint && <p class="font-mono text-xs text-dim">{t.listHint}</p>}
      </div>

      <div class="border border-line bg-ink/60 text-sm">
        <div class="hidden grid-cols-[minmax(0,14rem)_1fr] gap-x-6 border-b border-line px-4 py-2.5 font-mono text-xs uppercase tracking-widest text-dim md:grid">
          {t.cols.map((c) => <span>{c}</span>)}
        </div>
        <ul class="divide-y divide-line">
          {
            projects.map((p) => (
              <li class="group relative">
                <a
                  href={p.href}
                  target="_blank"
                  rel="noopener"
                  class="grid grid-cols-[1fr_auto] gap-x-6 gap-y-1 px-4 py-4 transition-colors hover:bg-panel md:grid-cols-[minmax(0,14rem)_1fr_auto] md:items-center"
                >
                  <span class="font-medium text-fg">{p.name}</span>
                  <span class="col-span-2 row-start-2 text-muted md:col-span-1 md:row-start-auto">{p.line}</span>
                  <span class="col-start-2 row-start-1 font-mono text-dim transition-transform group-hover:-translate-y-0.5 group-hover:translate-x-0.5 group-hover:text-fg md:col-start-auto md:row-start-auto">↗</span>
                </a>
                <span class="pointer-events-none absolute left-0 top-1/2 h-0 w-px -translate-y-1/2 bg-gradient-to-b from-cyan to-violet transition-all duration-300 group-hover:h-3/5" />
              </li>
            ))
          }
        </ul>
      </div>
    </section>
  </main>

  <footer class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-3 border-t border-line px-4 py-8 font-mono text-xs text-dim sm:px-8">
    <span>{t.by} <a href="https://jaimeaza.tech" class="text-muted hover:text-fg" rel="author">Jaime Aza ↗</a></span>
    <span class="flex items-center gap-5">
      {t.legal.map((l) => <a href={l.href} class="hover:text-fg">{l.label}</a>)}
      <span>© {year} jato.run</span>
    </span>
  </footer>
</Base>
