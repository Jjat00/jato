---
// Layout de las páginas legales (privacidad y términos), escritas en Markdown.
import Base from "./Base.astro";

const { frontmatter } = Astro.props;
const { lang, title, description, updated, other } = frontmatter;
const home = lang === "es" ? "/" : "/en/";
---

<Base lang={lang} title={`${title} · jato`} description={description}>
  <header class="mx-auto flex max-w-3xl items-center justify-between px-4 py-6 sm:px-8">
    <a href={home} class="group flex items-baseline gap-0.5" aria-label="jato.run">
      <span class="text-2xl font-semibold tracking-tight">jato</span>
      <span class="font-mono text-sm text-dim transition-colors group-hover:text-muted">.run</span>
    </a>
    <a href={other.href} class="font-mono text-xs uppercase tracking-widest text-muted hover:text-fg">{other.label}</a>
  </header>

  <main class="mx-auto max-w-3xl px-4 pb-24 pt-8 sm:px-8">
    <p class="font-mono text-xs uppercase tracking-[0.2em] text-dim">{updated}</p>
    <h1 class="mt-3 text-4xl font-semibold tracking-tight sm:text-5xl">{title}</h1>
    <article class="legal mt-10">
      <slot />
    </article>
  </main>

  <footer class="mx-auto flex max-w-3xl flex-wrap items-center justify-between gap-3 border-t border-line px-4 py-8 font-mono text-xs text-dim sm:px-8">
    <a href={home} class="hover:text-fg">← jato.run</a>
    <span>© {new Date().getFullYear()} jato.run</span>
  </footer>
</Base>
